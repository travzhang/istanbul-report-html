{
  "name": "canyonjs-dev-report-html",
  "version": "1.0.18",
  "description": "Istanbul coverage report HTML bundle",
  "type": "module",
  "files": [
    "dist"
  ],
  "author": "Travis Zhang (https://github.com/travzhang)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "pnpm -C ../report-component build && vite",
    "build": "tsc -b && vite build",
