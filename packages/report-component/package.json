{
  "name": "canyonjs-dev-report-component",
  "type": "module",
  "version": "1.0.18",
  "description": "A starter for creating a React component library.",
  "author": "Travis Zhang (https://github.com/travzhang)",
  "license": "MIT",
  "homepage": "https://github.com/travzhang/istanbul-report-html#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travzhang/istanbul-report-html.git"
  },
  "bugs": {
    "url": "https://github.com/travzhang/istanbul-report-html/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
